---
import HeaderLink from './HeaderLink.astro';
import NonoiseLogo from './branding/NonoiseLogo.astro';
---

<header>
	<nav>
		<NonoiseLogo />
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--peach);
		box-shadow: 0 2px 8px rgba(43, 35, 24, 8%);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1020px;
		margin-inline: auto;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--obsidian);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
