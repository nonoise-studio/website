---
interface Props {
	tag: string;
	title: string;
	desc: string;
}

const { tag, title, desc } = Astro.props;
---

<article class="card">
	<span class="card-tag">{tag}</span>
	<h3 class="card-title">{title}</h3>
	<p class="card-desc">{desc}</p>
</article>

<style>
	.card {
		background: var(--peach);
		border: 0.5px solid color-mix(in srgb, var(--obsidian) 12%, transparent);
		border-radius: 8px;
		padding: 1em;
		display: flex;
		flex-direction: column;
		gap: 8px;
		transition: background 0.25s ease, transform 0.15s ease;
	}

	.card:hover {
		background: color-mix(in srgb, var(--obsidian) 4%, var(--peach));
		transform: translateY(-2px);
	}

	.card:hover .card-title {
		color: var(--electric);
	}

	.card-tag {
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--terra);
		font-weight: 500;
		border-bottom: thin solid var(--terra);
	}

	.card-title {
		font-size: 1em;
		font-weight: 500;
		margin: 0;
		transition: color 0.25s;
	}

	.card-desc {
		font-size: 0.95em;
		font-weight: 300;
		margin: 0;
		line-height: 1.3;
		color: color-mix(in srgb, var(--obsidian) 70%, var(--peach));
	}
</style>
