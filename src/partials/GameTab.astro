---
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
---
<BeforeAfterSlider>
    <Fragment slot="before">
        <svg class="ill" viewBox="0 0 560 160" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="8" width="560" height="144" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="10" y="24" font-size="8" font-weight="500" fill="var(--color-text-secondary)" font-family="var(--font-sans)">STRATEGIC ALIGNMENT WORKSHOP — SESSION 4 OF 12</text>
            <line x1="0" y1="28" x2="560" y2="28" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="10" y="42" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Slide 47 of 94</text>
            <rect x="10" y="48" width="340" height="80" rx="2" fill="var(--color-background-primary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="20" y="62" font-size="7" fill="var(--color-text-secondary)" font-family="var(--font-sans)">The core competency framework (ref: McKinsey 2019, adapted)</text>
            <text x="20" y="74" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• Sub-pillar A: organisational resilience maturity model (tier 2–4)</text>
            <text x="20" y="84" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• Sub-pillar B: cross-functional value chain alignment (see appendix C)</text>
            <text x="20" y="94" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• Sub-pillar C: stakeholder sentiment calibration index</text>
            <text x="20" y="104" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• Sub-pillar D: dynamic capability reconfiguration (Teece, 2007)</text>
            <text x="20" y="114" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• Sub-pillar E: emergent synergy realisation pathway (EST. Q3)</text>
            <text x="20" y="124" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• note: framework subject to revision pending board sign-off</text>
            <rect x="358" y="48" width="192" height="80" rx="2" fill="var(--color-background-primary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="368" y="62" font-size="7" fill="var(--color-text-secondary)" font-family="var(--font-sans)">Who is in the room?</text>
            <text x="368" y="74" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• 2 consultants (billed at €420/hr)</text>
            <text x="368" y="84" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• 1 director (checked phone 14x)</text>
            <text x="368" y="94" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• 3 managers (unclear why)</text>
            <text x="368" y="104" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• 1 "observer" (asleep)</text>
            <text x="368" y="114" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">• Jan (Jan left in 2021)</text>
            <text x="10" y="142" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Next session: Tues 14:00 — please read the 84-page pre-read beforehand</text>
        </svg>
    </Fragment>
    <Fragment slot="after">
        <svg class="ill" viewBox="0 0 560 160" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="240" height="140" rx="6" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="130" y="30" font-size="9" text-anchor="middle" font-weight="500" fill="var(--color-text-secondary)" font-family="var(--font-sans)">SIMULATION</text>
            <rect x="30" y="38" width="60" height="40" rx="4" fill="var(--electric)" opacity="0.2" stroke="var(--electric)" stroke-width="0.5"/>
            <text x="60" y="62" font-size="8" text-anchor="middle" fill="var(--electric)" font-family="var(--font-sans)">Supply</text>
            <rect x="110" y="38" width="60" height="40" rx="4" fill="#185FA5" opacity="0.2" stroke="#185FA5" stroke-width="0.5"/>
            <text x="140" y="62" font-size="8" text-anchor="middle" fill="#185FA5" font-family="var(--font-sans)">Demand</text>
            <rect x="70" y="98" width="60" height="40" rx="4" fill="#BA7517" opacity="0.2" stroke="#BA7517" stroke-width="0.5"/>
            <text x="100" y="122" font-size="8" text-anchor="middle" fill="#BA7517" font-family="var(--font-sans)">Balance</text>
            <line x1="90" y1="78" x2="100" y2="98" stroke="var(--color-border-secondary)" stroke-width="0.5"/>
            <line x1="140" y1="78" x2="120" y2="98" stroke="var(--color-border-secondary)" stroke-width="0.5"/>
            <text x="310" y="50" font-size="13" font-weight="500" text-anchor="middle" fill="var(--color-text-primary)" font-family="var(--font-sans)">Play it.</text>
            <text x="310" y="70" font-size="13" font-weight="500" text-anchor="middle" fill="var(--color-text-primary)" font-family="var(--font-sans)">Break it.</text>
            <text x="310" y="90" font-size="13" font-weight="500" text-anchor="middle" fill="var(--electric)" font-family="var(--font-sans)">Understand it.</text>
            <text x="310" y="120" font-size="10" text-anchor="middle" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">No pre-read required.</text>
        </svg>
    </Fragment>
</BeforeAfterSlider>