            <text x="6" y="146" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">** data as of last sync — may not reflect today</text>
            <text x="6" y="150" font-size="6" fill="#c0392b" font-family="var(--font-sans)">⚠ 3 data quality warnings</text>
            <rect x="188" y="62" width="85" height="90" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="194" y="74" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">SEGMENT DIST.</text>
            <circle cx="231" cy="105" r="28" fill="none" stroke="#c0392b" stroke-width="14" stroke-dasharray="44 88"/>
            <circle cx="231" cy="105" r="28" fill="none" stroke="#2980b9" stroke-width="14" stroke-dasharray="26 106" stroke-dashoffset="-44"/>
            <circle cx="231" cy="105" r="28" fill="none" stroke="#27ae60" stroke-width="14" stroke-dasharray="18 114" stroke-dashoffset="-70"/>
            <circle cx="231" cy="105" r="28" fill="none" stroke="#d4a017" stroke-width="14" stroke-dasharray="12 120" stroke-dashoffset="-88"/>
            <circle cx="231" cy="105" r="28" fill="none" stroke="#8e44ad" stroke-width="14" stroke-dasharray="8 124" stroke-dashoffset="-100"/>
