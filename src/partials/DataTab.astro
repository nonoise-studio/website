---
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
---
<BeforeAfterSlider>
    <Fragment slot="before">
        <svg class="ill" viewBox="0 0 560 160" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="85" height="55" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="6" y="12" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">TOTAL REVENUE YTD</text>
            <text x="6" y="28" font-size="14" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">€124,882</text>
            <text x="6" y="40" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">vs prev period rolling avg</text>
            <polyline fill="none" stroke="#888" stroke-width="1" points="6,52 18,46 30,50 42,40 54,44 66,36 78,40"/>
            <rect x="92" y="0" width="85" height="55" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="98" y="12" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">DAU 30D ROLLING</text>
            <text x="98" y="28" font-size="14" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">3,291</text>
            <rect x="98" y="34" width="30" height="4" rx="2" fill="#c0392b"/>
