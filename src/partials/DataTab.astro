            <rect x="98" y="46" width="20" height="4" rx="2" fill="#27ae60"/>
            <rect x="184" y="0" width="85" height="55" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="190" y="12" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">CONVERSION RATE %</text>
            <text x="190" y="28" font-size="14" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">2.4%</text>
            <polyline fill="none" stroke="#e67e22" stroke-width="1" points="190,52 202,46 214,50 226,38 238,44 250,34 262,38"/>
            <rect x="276" y="0" width="85" height="55" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="282" y="12" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">NPS SCORE 90D</text>
            <text x="282" y="28" font-size="14" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">42</text>
            <polyline fill="none" stroke="#27ae60" stroke-width="1" points="282,52 294,48 306,50 318,42 330,44 342,36 354,32"/>
            <rect x="0" y="62" width="180" height="90" rx="3" fill="var(--color-background-secondary)" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <text x="6" y="74" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">MONTHLY BY CATEGORY (ALL)</text>
            <rect x="6" y="78" width="10" height="40" rx="1" fill="#c0392b"/>
            <rect x="18" y="88" width="10" height="30" rx="1" fill="#d4a017"/>
            <rect x="30" y="82" width="10" height="36" rx="1" fill="#2980b9"/>
            <rect x="42" y="94" width="10" height="24" rx="1" fill="#27ae60"/>
