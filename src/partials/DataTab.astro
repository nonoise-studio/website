            <text x="286" y="74" font-size="7" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">PIPELINE STATUS</text>
            <rect x="286" y="80" width="50" height="5" rx="2" fill="#c0392b"/>
            <rect x="286" y="88" width="35" height="5" rx="2" fill="#d4a017"/>
            <rect x="286" y="96" width="60" height="5" rx="2" fill="#2980b9"/>
            <rect x="286" y="104" width="25" height="5" rx="2" fill="#27ae60"/>
            <rect x="286" y="112" width="45" height="5" rx="2" fill="#8e44ad"/>
            <rect x="286" y="120" width="30" height="5" rx="2" fill="#e67e22"/>
            <text x="286" y="140" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">6 categories shown</text>
            <text x="286" y="148" font-size="6" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">filter: none applied</text>
        </svg>
    </Fragment>
    <Fragment slot="after">
        <svg class="ill" viewBox="0 0 560 160" xmlns="http://www.w3.org/2000/svg">
            <text x="0" y="28" font-size="28" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">€124k</text>
            <text x="0" y="42" font-size="11" fill="var(--color-text-secondary)" font-family="var(--font-sans)">Revenue this quarter — ↑ 12% vs last</text>
            <line x1="0" y1="52" x2="200" y2="52" stroke="var(--color-border-tertiary)" stroke-width="0.5"/>
            <rect x="0" y="62" width="24" height="60" rx="2" fill="var(--terra)" opacity="0.4"/>
            <rect x="28" y="52" width="24" height="70" rx="2" fill="var(--terra)" opacity="0.5"/>
            <rect x="56" y="58" width="24" height="64" rx="2" fill="var(--terra)" opacity="0.6"/>
            <rect x="84" y="44" width="24" height="78" rx="2" fill="var(--terra)" opacity="0.7"/>
            <rect x="112" y="48" width="24" height="74" rx="2" fill="var(--terra)" opacity="0.85"/>
            <rect x="140" y="36" width="24" height="86" rx="2" fill="var(--terra)"/>
            <text x="0" y="136" font-size="9" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Jan</text>
            <text x="28" y="136" font-size="9" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Feb</text>
            <text x="56" y="136" font-size="9" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Mar</text>
            <text x="84" y="136" font-size="9" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Apr</text>
            <text x="112" y="136" font-size="9" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">May</text>
            <text x="140" y="136" font-size="9" fill="var(--color-text-tertiary)" font-family="var(--font-sans)">Jun</text>
            <text x="240" y="28" font-size="16" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">One chart.</text>
            <text x="240" y="48" font-size="16" font-weight="500" fill="var(--color-text-primary)" font-family="var(--font-sans)">One number.</text>
            <text x="240" y="68" font-size="16" font-weight="500" fill="var(--terra)" font-family="var(--font-sans)">One decision.</text>
        </svg>
    </Fragment>
</BeforeAfterSlider>