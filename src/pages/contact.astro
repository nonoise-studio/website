---
import Page from '../layouts/Page.astro';
---

<Page title="Contact · nonoise" description="Get in touch with nonoise studio.">
	<section class="contact-page">
		<h1>Contact</h1>
		<strong>Get in touch with me!</strong>
		<p>Got a question, an idea or something exciting to share? I'm all ears. Send me a message and I'll get back to you as soon as possible.</p>
		</p>

		<div class="contact-links">
			<a href="mailto:changeme@example.com">changeme@example.com</a>
			<a href="#" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>

		<div class="business-details">

			<div class="details">
					<strong>Nonoise Studio</strong>
					<span>3024 EZ, Rotterdam</span>
					<span>KvK: 42054113</span>
			</div>
		</div>
	</section>
</Page>

<style>
	.contact-page {
		max-width: 32rem;
	}

	h1 {
		font-family: var(--font-bitcount, monospace);
		font-weight: 400;
	}

	.contact-links {
		display: flex;
		gap: 2rem;
		margin-top: 2rem;
	}

	.contact-links a {
		color: var(--electric);
		text-decoration: none;
		border-bottom: 1px solid var(--electric);
	}

	.contact-links a:hover {
		background: var(--electric);
		color: white;
	}

	.business-details {
		margin-top: 5rem;
	}

	.details {
		display: flex;
		flex-direction: column;
		gap: 0em;
	}

	.details > * {
		margin: 0;
		line-height: 1.5;
	}

	.details span {
		width: 8rem;
		flex-shrink: 0;
		text-wrap: nowrap;
		color: color-mix(
			in srgb,
			var(--obsidian) 55%,
			var(--peach)
		);
	}

	.details strong {
		font-weight: 400;
	}

	@media (max-width: 500px) {
		.details > div {
			display: block;
		}

		.details span {
			display: block;
			width: auto;
			margin-bottom: 0.2rem;
		}
	}
</style>