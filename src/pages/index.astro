---
import Page from '../layouts/Page.astro';
import DotBanner from '../components/branding/DotBanner.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Method from '../components/Method.astro';
import ClientBanner from '../components/ClientBanner.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const clients = [
	{
		name: 'Attenza',
		website: 'https://attenza.nl/',
		logo: 'https://www.attenza.nl/wp/wp-content/uploads/2021/11/Logo.png',
	},
	// {
	// 	name: 'Placeholder',
	// 	website: 'https://placeholder.com/',
	// 	logo: 'https://imgs.search.brave.com/p90nca8FKVz9jxlEuGEOkZfkGJ9brr9Ns35dTqcsDnk/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9zdGF0/aWMudmVjdGVlenku/Y29tL3N5c3RlbS9y/ZXNvdXJjZXMvdGh1/bWJuYWlscy8wODIv/MzQwLzg3NS9zbWFs/bC9tdWx0aWNvbG9y/ZWQtYnVzaW5lc3Mt/bG9nby13aXRoLXN0/YWNrZWQtbGF5ZXJz/LWFuZC10ZXh0LXBs/YWNlaG9sZGVyLXZl/Y3Rvci5qcGc',
	// }
];
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div style="margin-block: 2rem; width: 100vw; margin-left: calc(50% - 50vw);">
		<DotBanner
			words={[' nonoise no nonsense ']}
			direction="left"
			speed={40}
			hoverEffect={false}
		/>
	</div>
	<section id="hero">
		<span class="hero-logo">nonoise</span>
		<h1>
			I help your business go from
			<span
				class="hero-swap-statement"
				id="hero-swap"
				data-swap="chaos to clarity,data to insight,idea to plan,noise to signal,complexity to fun"
			>
				chaos to clarity
			</span>
		</h1>
		<a href="/contact" class="cta">Let's fix it →</a>
	</section>

	<div style="margin-block: 2rem; width: 100vw; margin-left: calc(50% - 50vw);">
		<DotBanner
			words={[' nonoise no nonsense ']}
			direction="left"
			speed={40}
			hoverEffect={false}
		/>
	</div>
	<section id="services">
		<ServiceGrid />
	</section>

	<!-- Clients banner. Only show if there are multiple clients -->
	{clients.length > 1 &&
	<div class="client-logos-container full-width-banner">
		<DotBanner
			words={[' trusted by ']}
			direction="left"
			speed={50}
			hoverEffect={false}
		/>
		<ClientBanner clients={clients} direction="right" speed={20} />
		<DotBanner
			words={[' trusted by ']}
			direction="left"
			speed={70}
			hoverEffect={false}
		/>
	</div>
	}

	<Method />

	<section id="contact">
		<a class="cta" href="/contact">Get in touch →</a>
	</section>
</Page>

<script>
	const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	async function typeOut(element: HTMLElement, text: string, speed = 50) {
		for (let i = 0; i <= text.length; i++) {
			element.textContent = text.slice(0, i);
			await sleep(speed);
		}
	}

	async function typeBack(element: HTMLElement, speed = 50) {
		const text = element.textContent ?? '';
		for (let i = text.length; i >= 0; i--) {
			element.textContent = text.slice(0, i);
			await sleep(speed);
		}
	}

	async function startSwap(element: HTMLElement, words: string[], delay = 3000, speed = 50) {
		let index = 0;
		while (true) {
			await sleep(delay);
			await typeBack(element, speed);
			index = (index + 1) % words.length;
			await typeOut(element, words[index], speed);
		}
	}

	const swapElement = document.getElementById('hero-swap');
	if (swapElement) {
		const words = swapElement.dataset?.swap?.split(',') ?? [];
		if (words.length > 0) startSwap(swapElement, words);
	}
</script>

<style>
	
	h2 {
		font-family: var(--font-bitcount, monospace);
		font-size: 1.8rem;
		color: var(--electric);
		font-weight: 500;
		margin: 4rem 0 1rem;
	}
	#hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 4rem 0 3rem;
		gap: 1rem;
	}

	.hero-logo {
		font-family: var(--font-bitcount, monospace);
		text-transform: lowercase;
		font-size: 3rem;
	}

	#hero h1 {
		font-weight: 400;
		font-size: clamp(1.8rem, 4vw, 3rem);
	}

	.hero-swap-statement {
		font-family: var(--font-bitcount, monospace);
		color: var(--electric);
		font-weight: 500;
		line-height: 0.9em;
		min-width: 9ch;
		min-height: 1em;
		display: block;
	}

	.client-logos-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 4rem 0;
	}

	.cta {
		display: inline-block;
		align-self: flex-start;
		margin-top: 2rem;
		padding: 0.75em 1.5em;
		border: 2px solid var(--electric);
		color: var(--electric);
		text-decoration: none;
		font-family: var(--font-fredoka, sans-serif);
		font-size: 1.1rem;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.cta:hover {
		background: var(--electric);
		color: white;
	}

	.full-width-banner {
		width: 100vw;
		margin-left: calc(50% - 50vw);
	}

	#contact {
		margin: 4rem 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	#contact h2 {
		font-family: var(--font-bitcount, monospace);
		font-size: 1.8rem;
	}

</style>
