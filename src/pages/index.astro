---
import Page from '../layouts/Page.astro';
import DotBanner from '../components/branding/DotBanner.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section id="hero">
		<span class="hero-logo">nonoise</span>
		<h1>
			I help your business go from
			<span
				class="hero-swap-statement"
				id="hero-swap"
				data-swap="chaos to clarity,data to insight,idea to plan,noise to signal,complexity to fun"
			>
				chaos to clarity
			</span>
		</h1>
		<a href="#contact" class="cta">Let's fix it →</a>
	</section>

	<DotBanner
		words={['data', 'process', 'automation', 'gamification']}
		direction="left"
		speed={40}
		hoverEffect={false}
	/>

	<ServiceGrid />

	<section id="how">
		<h2>How we work</h2>
		<DotBanner
			words={['no nonsense', 'no decorum', 'no noise']}
			direction="right"
			speed={30}
			hoverEffect={false}
		/>
		<ul>
			<li>No decks for the sake of decks.</li>
			<li>No meetings for the sake of meetings.</li>
			<li>No jargon to sound smart.</li>
			<li>Just the problem, the solution, and the result.</li>
		</ul>
	</section>

	<section id="contact">
		<h2>Enough talk.</h2>
		<p>Rotterdam, NL. Freelance, one person, no noise.</p>
		<div class="contact-links">
			<a href="mailto:hello@nonoisestudio.nl">hello@nonoisestudio.nl</a>
			<a href="/contact">Contact form</a>
		</div>
	</section>
</Page>

<script>
	const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	async function typeOut(element: HTMLElement, text: string, speed = 50) {
		for (let i = 0; i <= text.length; i++) {
			element.textContent = text.slice(0, i);
			await sleep(speed);
		}
	}

	async function typeBack(element: HTMLElement, speed = 50) {
		const text = element.textContent ?? '';
		for (let i = text.length; i >= 0; i--) {
			element.textContent = text.slice(0, i);
			await sleep(speed);
		}
	}

	async function startSwap(element: HTMLElement, words: string[], delay = 3000, speed = 50) {
		let index = 0;
		while (true) {
			await sleep(delay);
			await typeBack(element, speed);
			index = (index + 1) % words.length;
			await typeOut(element, words[index], speed);
		}
	}

	const swapElement = document.getElementById('hero-swap');
	if (swapElement) {
		const words = swapElement.dataset?.swap?.split(',') ?? [];
		if (words.length > 0) startSwap(swapElement, words);
	}
</script>

<style>
	#hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 4rem 0 3rem;
		gap: 1rem;
	}

	.hero-logo {
		font-family: var(--font-bitcount, monospace);
		text-transform: lowercase;
		font-size: 3rem;
	}

	#hero h1 {
		font-weight: 400;
		font-size: clamp(1.8rem, 4vw, 3rem);
	}

	.hero-swap-statement {
		font-family: var(--font-bitcount, monospace);
		color: var(--electric);
		font-weight: 500;
		line-height: 0.9em;
		min-width: 9ch;
		min-height: 1em;
		display: block;
	}

	.cta {
		display: inline-block;
		align-self: flex-start;
		margin-top: 2rem;
		padding: 0.75em 1.5em;
		border: 2px solid var(--electric);
		color: var(--electric);
		text-decoration: none;
		font-family: var(--font-fredoka, sans-serif);
		font-size: 1.1rem;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.cta:hover {
		background: var(--electric);
		color: white;
	}

	#how,
	#contact {
		margin: 4rem 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	#how h2,
	#contact h2 {
		font-family: var(--font-bitcount, monospace);
		font-size: 1.8rem;
	}

	#how ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	#how ul li::before {
		content: '— ';
		color: var(--electric);
	}

	.contact-links {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.contact-links a {
		color: var(--electric);
		text-decoration: none;
		border-bottom: 1px solid var(--electric);
	}

	.contact-links a:hover {
		background: var(--electric);
		color: white;
	}
</style>
